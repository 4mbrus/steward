[Desktop Entry]
Type=Application
Name=App Commander
Comment=Manage installed applications, their menu entries and updates
Exec=app-commander
Icon=io.github.appcommander.AppCommander
Terminal=false
Categories=GTK;GNOME;System;PackageManager;
Keywords=uninstall;update;desktop entry;menu editor;flatpak;appimage;apt;snap;
StartupNotify=true
